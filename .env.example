# ==============================================================================
# إعدادات البيئة لمشروع المكتبة المعرفية الذكية (Smart Knowledge Library)
# انسخ هذا الملف إلى .env قبل تشغيل الخادم السحابي (FastAPI Backend)
# ==============================================================================

# مفتاح Gemini API المجاني (من https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# إعدادات الخادم السحابي
PORT=8000
HOST=0.0.0.0

# الحد الأقصى الصارم لمدة المقطع الصوتي بالثواني (دقيقتان = 120 ثانية)
MAX_AUDIO_DURATION_SEC=120

# مسار تخزين ملفات الرفع المؤقتة لبروتوكول TUS
TUS_UPLOAD_DIR=./tus_uploads
